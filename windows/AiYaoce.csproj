<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>ai-yaoce</AssemblyName>
    <RootNamespace>AiYaoce</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <OutputPath>..\release\windows-lite\app\</OutputPath>
    <IntermediateOutputPath>..\build\windows-lite\obj\</IntermediateOutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('..\build\windows-lite\app.ico')">..\build\windows-lite\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Compile Include="Core.cs" /><Compile Include="MainForm.cs" /><Compile Include="Program.cs" />
    <EmbeddedResource Include="..\assets\ai-yaoce-logo.png"><LogicalName>logo.png</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
